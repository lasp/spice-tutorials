# Quarto build output
/_site/
/.quarto/
# NOTE: do NOT ignore /_freeze/ -- it holds the executed outputs of the
# slides, so the Pages workflow can publish without Python or NAIF kernels.
slides/*.html
slides/*_files/
*_files/

# SPICE kernels are downloaded, not committed
kernels/*
!kernels/*.tm
!kernels/README.md

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
*.egg-info/
notebooks/*.tm
venv/

# OS / editor
.DS_Store
.vscode/
.idea/

**/*.quarto_ipynb
